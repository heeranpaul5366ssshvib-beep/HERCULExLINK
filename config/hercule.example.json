{
  "models": {
    "default_model": "llama3.2:3b",
    "ollama_host": "http://127.0.0.1:11434",
    "ollama_timeout_s": 120.0,
    "ollama_options": {"num_predict": 512},
    "model_preferences": ["llama3.2:3b", "qwen2.5:1.5b", "qwen3:0.6b", "qwen3.5:0.8b"],
    "allow_mock_fallback": false
  },
  "planning": {
    "cognitive_planning": "auto",
    "planning_timeout_s": 80.0
  },
  "tasks": {
    "task_store": "data/tasks.json"
  },
  "memory": {
    "memory_dir": "data/memory"
  },
  "autonomy": {
    "enabled": false,
    "poll_interval_s": 1.0,
    "max_task_runtime_s": 300.0,
    "max_concurrent_tasks": 1
  },
  "embeddings": {
    "mode": "production",
    "provider": "sentence-transformers",
    "model_id": "sentence-transformers/all-MiniLM-L6-v2",
    "dimension": 384,
    "normalized": true,
    "device": "cpu",
    "batch_size": 32,
    "cache": true,
    "cache_version": "1",
    "fallback_provider": "",
    "fallback_model_id": "",
    "allow_test_providers": false
  }
}
