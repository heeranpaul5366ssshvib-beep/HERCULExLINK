{
  "productName": "HERCULE",
  "appId": "com.hercule.ai",
  "copyright": "Copyright © 2024 HERCULE AI",
  "directories": {
    "output": "dist/packages",
    "buildResources": "build"
  },
  "files": [
    "dist/main/**/*",
    "dist/preload/**/*",
    "dist/renderer/**/*",
    "resources/**/*",
    "!resources/llama/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/models",
      "to": "models",
      "filter": ["**/*"]
    },
    {
      "from": "resources/llama",
      "to": "llama",
      "filter": ["**/*"]
    }
  ],
  "asar": true,
  "compression": "maximum",
  "npmRebuild": true,
  "publish": {
    "provider": "github",
    "owner": "your-org",
    "repo": "hercule-desktop"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "verifyUpdateCodeSignature": false,
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "HERCULE",
    "uninstallDisplayName": "HERCULE",
    "artifactName": "HERCULE-Setup-${version}-${arch}.${ext}"
  },
  "msi": {
    "oneClick": false,
    "perMachine": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "HERCULE",
    "artifactName": "HERCULE-${version}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "HERCULE-Portable-${version}-${arch}.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "build/icon.icns",
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "artifactName": "HERCULE-${version}-${arch}.${ext}",
    "darkModeSupport": true
  },
  "dmg": {
    "title": "HERCULE Installer",
    "window": {
      "width": 540,
      "height": 380
    },
    "contents": [
      { "x": 180, "y": 170, "type": "link", "path": "/Applications" },
      { "x": 360, "y": 170, "type": "file" }
    ],
    "artifactName": "HERCULE-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "deb",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "flatpak",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "build/icon-512.png",
    "category": "Development",
    "maintainer": "HERCULE AI <support@hercule.ai>",
    "description": "HERCULE - Your Local AI Assistant",
    "artifactName": "HERCULE-${version}-${arch}.${ext}",
    "synopsis": "Local AI Assistant",
    "executableName": "hercule"
  },
  "appImage": {},
  "flatpak": {
    "finishArgs": [
      "--share=network",
      "--share=ipc",
      "--socket=x11",
      "--socket=wayland",
      "--device=dri",
      "--filesystem=home"
    ]
  }
}