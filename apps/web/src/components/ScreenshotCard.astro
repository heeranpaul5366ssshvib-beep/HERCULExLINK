---
interface Props {
  title: string;
  description: string;
  image: string;
  alt: string;
  class?: string;
}
const { title, description, image, alt, class: className = '' } = Astro.props;
---

<article class={cn('group relative overflow-hidden rounded-2xl border border-border-primary bg-slate-900/30 transition-all duration-300 hover:border-border-secondary hover:shadow-xl', className)}>
  <div class="aspect-video relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 via-transparent to-violet-500/10" />
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="text-center p-8">
        <svg class="mx-auto mb-4 w-16 h-16 text-blue-500/50 group-hover:text-blue-500/70 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <p class="text-text-tertiary">Screenshot placeholder</p>
        <p class="text-xs text-text-muted mt-1">Add {image} to public folder</p>
      </div>
    </div>
    <img 
      src={image} 
      alt={alt} 
      class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-300"
      loading="lazy"
    />
  </div>
  <div class="p-6">
    <h3 class="text-lg font-semibold text-text-primary mb-2">{title}</h3>
    <p class="text-text-secondary">{description}</p>
  </div>
</article>

<script>
  import { cn } from '../utils/cn';
</script>