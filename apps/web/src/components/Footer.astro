          </a>
          <a href="https://discord.gg/hercule" target="_blank" rel="noopener noreferrer" class="text-text-tertiary hover:text-text-primary transition-colors" aria-label="Discord">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.675 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.083.083 0 00.031.057 19.9 19.9 0 005.992 3.03.078.078 0 00.084-.028 14.09 14.09 0 001.226-1.994.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.007-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.09.247.18.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.645.673 1.31.956 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.418-4.477-.422-9.013-1.892-13.543a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418z"/></svg>
          </a>
          <a href="https://twitter.com/herculeai" target="_blank" rel="noopener noreferrer" class="text-text-tertiary hover:text-text-primary transition-colors" aria-label="Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
          </a>
        </div>
      </div>

      <nav>
        <h4 class="font-semibold text-text-primary mb-4">Product</h4>
        <ul class="space-y-3">
          <li><a href="#features" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Features</a></li>
          <li><a href="#screenshots" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Screenshots</a></li>
          <li><a href="#download" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Download</a></li>
          <li><a href="https://github.com/your-org/hercule/blob/main/docs/getting-started.md" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Documentation</a></li>
          <li><a href="https://github.com/your-org/hercule/releases" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Changelog</a></li>
        </ul>
      </nav>

      <nav>
        <h4 class="font-semibold text-text-primary mb-4">Platforms</h4>
        <ul class="space-y-3">
          <li><a href="#download" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Windows</a></li>
          <li><a href="#download" class="text-text-secondary hover:text-text-primary transition-colors text-sm">macOS</a></li>
          <li><a href="#download" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Linux</a></li>
          <li><a href="#download" class="text-text-secondary hover:text-text-primary transition-colors text-sm">iOS</a></li>
          <li><a href="#download" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Android</a></li>
        </ul>
      </nav>

      <nav>
        <h4 class="font-semibold text-text-primary mb-4">Community</h4>
        <ul class="space-y-3">
          <li><a href="https://github.com/your-org/hercule/discussions" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Discussions</a></li>
          <li><a href="https://github.com/your-org/hercule/issues" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Issues</a></li>
          <li><a href="https://github.com/your-org/hercule/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Contributing</a></li>
          <li><a href="https://github.com/your-org/hercule/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Code of Conduct</a></li>
          <li><a href="https://discord.gg/hercule" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors text-sm">Discord</a></li>
        </ul>
      </nav>
    </div>

    <div class="pt-8 border-t border-border-primary">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm text-text-tertiary">
          © {currentYear} HERCULE. MIT Licensed. Built with ❤️ by the HERCULE team.
        </p>
        <div class="flex items-center gap-6 text-sm text-text-tertiary">
          <a href="/privacy" class="hover:text-text-primary transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-text-primary transition-colors">Terms of Service</a>
          <a href="/security" class="hover:text-text-primary transition-colors">Security</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { cn } from '../utils/cn';
</script>