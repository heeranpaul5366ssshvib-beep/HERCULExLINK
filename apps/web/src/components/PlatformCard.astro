---
interface Props {
  platform: string;
  versions: string[];
  downloads: Array<{ label: string; href: string; size: string; recommended?: boolean }>;
  icon: 'windows' | 'apple' | 'linux' | 'android';
  accent: 'blue' | 'violet' | 'emerald' | 'amber';
  class?: string;
}
const { platform, versions, downloads, icon, accent, class: className = '' } = Astro.props;

const icons = {
  windows: '<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M19.431 10.034C18.068 8.137 15.984 7 13.5 7c-4.418 0-8 2.582-8 6 0 1.661.561 3.176 1.494 4.356L2.004 20.25 4.5 21.75l11.436-3.963c.541.264 1.111.407 1.71.407 2.206 0 4-1.794 4-4 0-.598-.14-1.169-.407-1.71l5.436-5.435z"/></svg>',
  apple: '<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M18.71 5.05A13.469 13.469 0 0112 2.25c-3.057 0-5.892 1.213-7.88 3.153A7.1 7.1 0 004.59 15.67a.75.75 0 00-.016 1.04 9.563 9.563 0 0011.5 1.41c.599 0 1.17-.15 1.67-.41a.75.75 0 00.41-1.27 7.573 7.573 0 01-6.42-6.16 12.52 12.52 0 012.84-5.7.75.75 0 00-1.33-.65z"/></svg>',
  linux: '<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M3.513 2.074a.75.75 0 00-1.027.077L.21 5.202a.75.75 0 000 1.08l2.276 3.05a.75.75 0 001.027.077l2.408-3.224-.251-4.136ZM3.46 6.49l-1.97 2.638a.75.75 0 000 1.079l1.97 2.638 2.08-2.784-1.97-2.638-2.08 2.785ZM9.563.75h6.45a.75.75 0 01.53 1.279l-3.224 4.32a.75.75 0 01-.53.021H9.563a.75.75 0 01-.53-.021l-3.225-4.32a.75.75 0 01.53-1.279ZM17.694 6.49l-2.08-2.784 1.97-2.638a.75.75 0 010-1.079l-1.97-2.638-2.08 2.784 1.97 2.638 2.08-2.784Zm-10.31 14.7l1.97 2.638a.75.75 0 000 1.079l-1.97 2.638-2.276-3.05a.75.75 0 000-1.08l2.276-3.05Zm14.222-.376a.75.75 0 00-1.027-.077l-2.276 3.05a.75.75 0 000 1.08l2.276 3.05a.75.75 0 001.027-.077l2.408-3.225.25-4.135a.75.75 0 00-.75-.75h-2.408Zm1.797 2.637-1.97-2.638a.75.75 0 000-1.079l-1.97 2.638 2.08 2.784 1.97 2.638 2.08-2.784Z"/></svg>',
  android: '<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M6.002 3.993a1.74 1.74 0 00-1.738 1.739v12.537c0 .96.78 1.74 1.738 1.74h11.996c.958 0 1.739-.78 1.739-1.74V5.732a1.74 1.74 0 00-1.739-1.739H6.002Zm1.738.003h8.52c.52 0 .938.423.938.939v12.537c0 .517-.418.939-.938.939H6.002a.939.939 0 01-.939-.939V4.936c0-.516.42-.939.939-.939Zm4.94 7.497a.94.94 0 11-1.878 0 .94.94 0 011.878 0Zm-2.11 4.111h4.22a.94.94 0 010 1.878h-4.22a.94.94 0 010-1.878Zm.94-6.33a.94.94 0 01-.939.939H8.83a.94.94 0 110-1.878h1.74a.94.94 0 01.939.939Zm10.327 1.878a.94.94 0 11-1.878 0 .94.94 0 011.878 0Z"/></svg>',
};

const accentColors = {
  blue: 'border-blue-500/20 bg-blue-500/5 hover:bg-blue-500/10',
  violet: 'border-violet-500/20 bg-violet-500/5 hover:bg-violet-500/10',
  emerald: 'border-emerald-500/20 bg-emerald-500/5 hover:bg-emerald-500/10',
  amber: 'border-amber-500/20 bg-amber-500/5 hover:bg-amber-500/10',
};

const accentTextColors = {
  blue: 'text-blue-400',
  violet: 'text-violet-400',
  emerald: 'text-emerald-400',
  amber: 'text-amber-400',
};

const accentBgColors = {
  blue: 'bg-blue-500/10 text-blue-400',
  violet: 'bg-violet-500/10 text-violet-400',
  emerald: 'bg-emerald-500/10 text-emerald-400',
  amber: 'bg-amber-500/10 text-amber-400',
};
---

<article class={cn('relative p-6 rounded-2xl border transition-all duration-300 hover:shadow-xl hover:-translate-y-1', accentColors[accent], 'bg-slate-900/30', className)}>
  <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: radial-gradient(ellipse at top right, var(--tw-gradient-from) 0%, transparent 70%);" />
  <div class="relative">
    <div class={cn('mb-4 flex h-16 w-16 items-center justify-center rounded-xl', accentBgColors[accent])}>
      {icons[icon]}
    </div>
    <h3 class="text-xl font-semibold text-text-primary mb-2">{platform}</h3>
    <ul class="mb-6 space-y-1 text-sm text-text-tertiary">
      {versions.map((version) => (
        <li key={version} class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>
          <span>{version}</span>
        </li>
      ))}
    </ul>
    <div class="space-y-2">
      {downloads.map((download) => (
        <a
          key={download.label}
          href={download.href}
          class={cn(
            'flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200',
            download.recommended
              ? `bg-gradient-to-r from-${accent}-600 to-${accent}-700 text-white shadow-lg`
              : 'bg-slate-800/50 text-text-secondary border border-border-primary hover:bg-slate-800 hover:text-text-primary hover:border-border-secondary'
          )}
        >
          <div class="flex items-center gap-3">
            {download.recommended && (
              <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-white/20">Recommended</span>
            )}
            <span>{download.label}</span>
          </div>
          <span class="text-xs font-mono opacity-75">{download.size}</span>
        </a>
      ))}
    </div>
  </div>
</article>

<script>
  import { cn } from '../utils/cn';
</script>