---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<section id="screenshots" class={className} aria-labelledby="screenshots-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-16">
      <h2 id="screenshots-heading" class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">
        See HERCULE in Action
      </h2>
      <p class="text-lg text-text-secondary max-w-2xl mx-auto">
        A beautiful, intuitive interface designed for productivity and focus.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <ScreenshotCard
        title="Chat Interface"
        description="Clean, distraction-free conversation with syntax highlighting, code blocks, and markdown rendering."
        image="/screenshots/chat.png"
        alt="HERCULE chat interface showing a conversation with code blocks"
      />
      <ScreenshotCard
        title="System Monitoring"
        description="Real-time CPU, RAM, GPU, and storage metrics with live activity timeline and plugin status."
        image="/screenshots/monitoring.png"
        alt="HERCULE system monitoring panel with circular progress indicators"
      />
      <ScreenshotCard
        title="Model Manager"
        description="Download, manage, and switch between multiple quantized models with progress tracking."
        image="/screenshots/models.png"
        alt="HERCULE model manager showing available and installed models"
      />
    </div>

    <div class="mt-12 text-center">
      <a 
        href="https://github.com/your-org/hercule" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium text-text-primary rounded-xl bg-slate-800/50 border border-border-primary hover:bg-slate-800 hover:border-border-secondary transition-all duration-200"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        View More on GitHub
      </a>
    </div>
  </div>
</section>

<ScreenshotCard
  title="Chat Interface"
  description="Clean, distraction-free conversation with syntax highlighting, code blocks, and markdown rendering."
  image="/screenshots/chat.png"
  alt="HERCULE chat interface showing a conversation with code blocks"
/>
<ScreenshotCard
  title="System Monitoring"
  description="Real-time CPU, RAM, GPU, and storage metrics with live activity timeline and plugin status."
  image="/screenshots/monitoring.png"
  alt="HERCULE system monitoring panel with circular progress indicators"
/>
<ScreenshotCard
  title="Model Manager"
  description="Download, manage, and switch between multiple quantized models with progress tracking."
  image="/screenshots/models.png"
  alt="HERCULE model manager showing available and installed models"
/>