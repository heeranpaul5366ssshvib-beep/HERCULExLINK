---
interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const { title, description, canonicalURL, ogImage, noIndex } = Astro.props;
const canonical = canonicalURL || Astro.site?.href + Astro.url.pathname;
const ogImg = ogImage || new URL('/og-image.png', Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  <link rel="canonical" href={canonical}>

  <title>{title}</title>
  <meta name="description" content={description}>

  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImg}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonical}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImg}>

  {noIndex && <meta name="robots" content="noindex, nofollow">}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "HERCULE",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Windows, macOS, Linux, iOS, Android",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    },
    "description": "HERCULE - Your Local AI Assistant. Run LLMs locally with privacy."
  })} />
</head>
<body class="bg-bg-primary text-text-primary antialiased">
  <slot />
</body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  :root {
    --bg-primary: #0d1326;
    --bg-secondary: #0f172a;
    --bg-tertiary: #111827;
    --bg-card: #141c2f;
    --bg-elevated: #1e293b;
    --border-primary: #1e293b;
    --border-secondary: #334155;
    --border-focus: #3b82f6;
    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --text-tertiary: #64748b;
    --accent-blue: #3b82f6;
    --accent-violet: #8b5cf6;
    --accent-emerald: #10b981;
    --accent-amber: #f59e0b;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Inter', system-ui, sans-serif; background: var(--bg-primary); color: var(--text-primary); line-height: 1.6; }
  ::selection { background: var(--accent-blue); color: var(--bg-primary); }
  :focus-visible { outline: 2px solid var(--accent-blue); outline-offset: 2px; }
</style>