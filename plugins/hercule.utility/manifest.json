{
  "plugin_id": "hercule.utility",
  "name": "HERCULE Utility",
  "version": "1.0.0",
  "description": "Safe utility plugin providing calculator, system information, and time/date functions",
  "author": "HERCULE Team",
  "homepage": "https://hercule.ai",
  "min_hercule_version": "1.0.0",
  "max_hercule_version": "2.0.0",
  "entrypoint": "plugin",
  "capabilities": [
    "calculator",
    "system_info",
    "time_utility",
    "file_operations"
  ],
  "permissions": [
    "system_info",
    "filesystem_read",
    "filesystem_write"
  ],
  "dependencies": [],
  "configuration_schema": {
    "default_precision": {
      "type": "int",
      "default": 10,
      "minimum": 1,
      "maximum": 50,
      "description": "Default decimal precision for calculator"
    },
    "time_format": {
      "type": "string",
      "default": "%Y-%m-%d %H:%M:%S",
      "description": "Default time format string"
    }
  },
  "plugin_api_version": "1.0",
  "icon": "assets/icon.png",
  "tags": [
    "utility",
    "calculator",
    "system",
    "time"
  ]
}